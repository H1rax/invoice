ANTHROPIC_API_KEY=your-api-key-here

# Náhodný dlouhý řetězec pro podepisování přihlašovacích cookies (jednou vygenerovat a už neměnit)
SECRET_KEY=change-me-to-a-random-string

# Starší způsob přihlášení bez registrace (volitelné, jmeno:heslo oddělené čárkou).
# Noví uživatelé se dnes registrují přímo v appce přes /register.
APP_USERS=admin:change-me

# Přihlášení přes Google (volitelné). Vyplňte, jen pokud chcete nabídnout
# tlačítko "Pokračovat přes Google" — jinak appka jede jen na e-mail/heslo.
# Návod, jak údaje získat, najdete v README nebo se zeptejte Clauda.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
